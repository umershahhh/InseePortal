# ─────────────────────────────────────────────────────────
#  INSEE — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  Never commit .env.local to git.
# ─────────────────────────────────────────────────────────

# Supabase project URL and anon key (safe to expose to browser)
# Get from: supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER put NEXT_PUBLIC_ prefix on this
# Used only in server-side API routes to bypass RLS for hardware writes
# Get from: same Settings → API page → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
